    sh:path hri:healthConditionOfInterest ;
    sh:pattern "^(http://snomed[.]info/id/[0-9]+|http://id[.]who[.]int/icd/entity/[0-9]+|http://id[.]who[.]int/icd/release/10/([0-9]{4}/)?[A-Za-z0-9][A-Za-z0-9.-]* |http://id[.]who[.]int/icd/release/11/.+ |http://www[.]orpha[.]net/ORDO/Orphanet_[0-9]+)$" .


    rdfs:label "Activity"@en ;
    sh:property <http://data.health-ri.nl/core/p2/ActivityShape#dct:type> ;
    sh:targetClass prov:Activity .

<http://data.health-ri.nl/core/p2/ActivityShape#dct:type> dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:description "The nature or genre of the resource."@en ;
    sh:name "type"@en ;
    sh:nodeKind sh:IRI ;
    sh:path dct:type .

<http://data.health-ri.nl/core/p2/AgentShape#dct:identifier> dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:description "An unambiguous reference to the resource within a given context."@en ;
    sh:minCount 1 ;
    sh:name "identifier"@en ;
    sh:nodeKind sh:Literal ;
    sh:path dct:identifier .

<http://data.health-ri.nl/core/p2/AgentShape#dct:spatial> dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:description "Spatial characteristics of the resource."@en ;
    sh:name "country"@en ;
    sh:nodeKind sh:IRI ;
    sh:path dct:spatial .

<http://data.health-ri.nl/core/p2/AgentShape#dct:type> dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:description "The nature or genre of the resource."@en ;
    sh:maxCount 1 ;
    sh:name "type"@en ;
    sh:nodeKind sh:IRI ;
    sh:path dct:type .

<http://data.health-ri.nl/core/p2/AgentShape#foaf:homepage> dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:description "A homepage for some thing."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "URL"@en ;
    sh:nodeKind sh:IRI ;
    sh:path foaf:homepage .

<http://data.health-ri.nl/core/p2/AgentShape#foaf:mbox> dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:description "An email address via which contact can be made. This property SHOULD be used to provide the email address of the Agent, specified using the fully qualified mailto: URI scheme defined in RFC 6068. The email SHOULD be used to establish a communication channel to the agent."@en ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:name "email"@en ;
    sh:nodeKind sh:IRI ;
    sh:path foaf:mbox ;
    sh:pattern "^mailto:.+@.+\\..+$" .

<http://data.health-ri.nl/core/p2/AgentShape#foaf:name> dash:editor dash:TextFieldEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:description "A name for some thing."@en ;
    sh:minCount 1 ;
    sh:name "name"@en ;
    sh:nodeKind sh:Literal ;
    sh:path foaf:name ;
    sh:uniqueLang true .

<http://data.health-ri.nl/core/p2/AgentShape#healthdcatap:publishernote> dash:editor dash:TextAreaEditor ;
    dash:viewer dash:LiteralViewer ;
    sh:description "A description of the publisher's activities."@en ;
    sh:maxCount 1 ;
    sh:name "publisher note"@en ;
    sh:nodeKind sh:Literal ;
    sh:path healthdcatap:publishernote ;
    sh:uniqueLang true .

<http://data.health-ri.nl/core/p2/AgentShape#healthdcatap:publishertype> dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:description "A type of organisation that makes the Dataset available."@en ;
    sh:maxCount 1 ;
    sh:name "publisher type"@en ;
    sh:nodeKind sh:IRI ;
    sh:path healthdcatap:publishertype .

hrishapes:AttributionShape a sh:NodeShape ;
    rdfs:label "Attribution"@en ;
    sh:property <http://data.health-ri.nl/core/p2/AttributionShape#dcat:hadRole>,
        <http://data.health-ri.nl/core/p2/AttributionShape#prov:agent> ;
    sh:targetClass prov:Attribution .

<http://data.health-ri.nl/core/p2/AttributionShape#dcat:hadRole> dash:editor dash:URIEditor ;
    dash:viewer dash:LabelViewer ;
    sh:description "The function of an entity or agent with respect to another entity or resource."@en ;
    sh:maxCount 1 ;
    sh:name "role"@en ;
    sh:nodeKind sh:IRI ;
    sh:path dcat:hadRole .

<http://data.health-ri.nl/core/p2/AttributionShape#prov:agent> dash:editor dash:BlankNodeEditor ;
    dash:viewer dash:DetailsViewer ;
    sh:description "The prov:agent property references a prov:Agent that influenced a resource."@en ;
    sh:maxCount 1 ;
    sh:name "agent"@en ;
    sh:node hrishapes:AgentShape ;
    sh:path prov:agent .

<http://data.health-ri.nl/core/p2/CatalogShape#dcat:catalog> dash:editor dash:URIEditor ;
    dash:viewer dash:URIViewer ;
    sh:description "A catalogue that is listed in the catalogue."@en ;
    sh:name "catalogue"@en ;
    sh:nodeKind sh:IRI ;
    sh:path dcat:catalog .

<http://data.health-ri.nl/core/p2/CatalogShape#dcat:contactPoint> dash:editor dash:BlankNodeEditor ;
    dash:viewer dash:DetailsViewer ;
    sh:description "Relevant contact information for the catalogued resource."@en ;

{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NUXT_PUBLIC_API_BASE",
    "MOLGENIS_APPS_HOST",
    "MOLGENIS_HTTP_PORT"
  ],
  "globalDependencies": ["dev-env.js", "dev-proxy.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // will treat everything NOT in .gitignore as inputs (smart!)
      "inputs": ["$TURBO_DEFAULT$"],
      // outputs turbo should cache, rest is uncached
      "outputs": ["dist/**", "showCase/**","gen-docs/**"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "lint": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "format": {
      "inputs": [
        "**/*.{ts,tsx,js,jsx,vue,json,md,yml,yaml}",
        ".prettierrc.*",
        "../.prettierrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": true
    },
    "checkFormat": {
      "inputs": [
        "**/*.{ts,tsx,js,jsx,vue,json,md,yml,yaml}",
        ".prettierrc.*",
        "../.prettierrc.*",
        "package.json"
      ],
      "outputs": [],
      "cache": true
    },
    "test-ci": {
      "dependsOn": ["build"],
      "outputs": [],
      "cache": true
    },
    "e2e": {
      "outputs": [],
      "cache": true
    }
  }
}